# ============================================================
#  انسخ هذا الملف باسم  .env  واملأ القيم
#  محلياً: لا تحتاج شيئاً — النظام يستخدم data/app.db تلقائياً
# ============================================================

# ---------- قاعدة البيانات ----------
# اتركهما فارغين للتشغيل المحلي على ملف.
# للقاعدة المستضافة (Turso) انسخ القيمتين من لوحة تحكم Turso:
# DATABASE_URL=libsql://اسم-قاعدتك.turso.io
# DATABASE_TOKEN=ضع-الرمز-هنا

# ---------- حساب المالك (super admin) ----------
# يُنشأ عند أول تشغيل فقط. إن تركتهما، يُولَّد اسم owner وكلمة مرور عشوائية
# تُطبع مرة واحدة في السجل. على الاستضافة لن ترى السجل، فحدّدهما هنا.

# ---------- الشبكة ----------
PORT=3000

# شغّله (=1) عند التشغيل خلف Cloudflare / Vercel / Nginx / أي وسيط HTTPS.
# يجعل النظام يثق بترويسة العنوان الحقيقي للزائر — وبدونه تُحسب كل الطلبات
# قادمة من الوسيط فتتعطّل الحماية من تخمين كلمات المرور.
BEHIND_PROXY=0

OWNER_USER=owner
OWNER_PASSWORD=
